   1          #include <REGX52.H>
   2          
   3          /**
   4            * @brief 串口初始化，4800bps@12.000MHz
   5            * @param  无
   6            * @retval 无
   7            */
   8          
   9          
  10          void UART_Init()
  11          {
  12   1        SCON=0x50;
  13   1        PCON |=0x80;
  14   1        TMOD &= 0x0F;   //设置定时器模式  高4位控制定时器1，低4位控制定时器0
  15   1        TMOD |= 0x20;   //设置定时器模式  加前面一行代码，保留高4位，并将低4位清零后设
             -为0001，代表定时器0工作在模式1
  16   1        TL1 = 0xF4;   //设定定时初值
  17   1        TH1 = 0xF4;   //设定定时器重装值
  18   1        ET1 = 0;    //禁止定时器1中断
  19   1        TR1 = 1;    //启动定时器1
  20   1        EA=1;
  21   1        ES=1;
  22   1      }
  23          
  24          /**
  25            * @brief 串口发送一个字节数据
  26            * @param  Byte要发送的一个字节数据
  27            * @retval 无
  28            */
  29          
  30          
  31          void UART_SendByte(unsigned char Byte)
  32          {
  33   1        SBUF=Byte;
  34   1        while(TI==0);
  35   1        TI=0;
  36   1      }


