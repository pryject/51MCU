   1          #include <REGX52.H>
   2          
   3          /**
   4            * @brief  定时器0初始化，1毫秒@12.000MHz
   5            * @param  无
   6            * @retval 无
   7            */
   8          
   9          
  10          
  11            void Timer0_Init(void)    //
  12          {
  13   1        TMOD &= 0xF0;   //设置定时器模式
  14   1        TMOD |= 0x01;   //设置定时器模式
  15   1        TL0 = 0x18;   //设置定时初值
  16   1        TH0 = 0xFC;   //设置定时初值
  17   1        TF0 = 0;    //清除TF0标志
  18   1        TR0 = 1;    //定时器0开始计时
  19   1        //少了中端的设置
  20   1        ET0=1;
  21   1        EA=1;//允许总中断
  22   1        PT0=0;//中断优先级=0
  23   1      }
  24          
  25          /*定时器中断函数模板
  26          void Timer0_Routine() interrupt 1
  27          { 
  28            static unsigned int T0Count;//在函数运行完之后不销毁，只由此函数引用
  29            TL0 = 0x18;
  30            TH0 = 0xFC;
  31            T0Count++;
  32            if(T0Count>=1000)
