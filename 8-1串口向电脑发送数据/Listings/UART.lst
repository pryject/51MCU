   3          void UART_Init()//4800bps@12.000MHz
   4          {
   5   1        SCON=0x40;
   6   1        PCON |=0x80;
   7   1        TMOD &= 0x0F;   //设置定时器模式  高4位控制定时器1，低4位控制定时器0
   8   1        TMOD |= 0x20;   //设置定时器模式  加前面一行代码，保留高4位，并将低4位清零后设
             -为0001，代表定时器0工作在模式1
   9   1        TL1 = 0xF4;   //设定定时初值
  10   1        TH1 = 0xF4;   //设定定时器重装值
  11   1        ET1 = 0;    //禁止定时器1中断
  12   1        TR1 = 1;    //启动定时器1
  13   1        
  14   1      }
  15          
  16          void UART_SendByte(unsigned char Byte)
  17          {
  18   1        SBUF=Byte;
  19   1        while(TI==0);
  20   1        TI=0;
  21   1      }


